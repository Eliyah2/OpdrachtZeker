#!/bin/sh
# Draait bij elke commit:
#   1. het financieel model (xlsx) valideren
#   2. xlsx-mirror en dashboard tegen elkaar toetsen
#   3. controleren of de site-deploymap synchroon is met de bronpagina's
# Geactiveerd met: git config core.hooksPath hooks
set -e

if [ -x ".venv-model/Scripts/python" ]; then PY=".venv-model/Scripts/python"; else PY="python3"; fi

echo "pre-commit: valideren financieel model (xlsx)..."
"$PY" scripts/verifieer_model.py | tail -1

echo "pre-commit: toetsen model-sync (xlsx-mirror vs dashboard)..."
"$PY" scripts/toets_model_sync.py

echo "pre-commit: controleren site-build (bronpagina's vs sites/public)..."
"$PY" scripts/bouw_site.py --check

echo "pre-commit: OK - model, dashboard en site-build zijn synchroon."
